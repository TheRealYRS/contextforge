{
  "name": "contextforge",
  "version": "1.0.0",
  "description": "Turn any project into a compact, structured collection of files that AI assistants can understand and work with.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "release:win": "npm run build && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.contextforge.app",
    "productName": "ContextForge",
    "copyright": "Copyright © ContextForge contributors",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ContextForge-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ContextForge"
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
